# GitHub fine-grained PAT: configured repositories, Issues read-only.
GITHUB_READ_PAT=

# Optional separate token for operator-approved issue replies.
# Reserved for operator-approved issue comments; current tooling does not load it.
GITHUB_ISSUE_REPLY_PAT=

# Optional ZenHub Personal API Key when config/resolver.json enables metadata.
ZENHUB_API_KEY=

# A source under a different owner needs its own token: a fine-grained PAT is
# scoped to one resource owner, so the default cannot be widened to reach it.
# Named per source by `token_env` in config/resolver.json.
GITHUB_READ_PAT_PLAYGROUND=
